{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Matrix",
  "version": "0.1.0",
  "identifier": "com.focusmatrix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Focus Matrix",
      "width": 720,
      "height": 480,
      "minWidth": 520,
      "minHeight": 360,
      "center": true,
      "decorations": true,
      "transparent": true,
      "visible": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}
