{
  "name": "focus-matrix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "backup:data": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-before-update.ps1",
    "version:save": "node scripts/save-version.mjs",
    "version:list": "node scripts/save-version.mjs --list",
    "version:test": "node --test scripts/save-version.test.mjs",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "test": "vitest run src",
    "check:ui": "node scripts/check-ui.mjs",
    "check:calendar": "node scripts/check-calendar.mjs",
    "check:completed": "node scripts/check-completed-tasks.mjs",
    "test:update": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-update-preservation.ps1",
    "android:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-android.ps1",
    "android:deploy:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-android-deploy.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@tauri-apps/plugin-window-state": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
